--================= AUTO FARM + HOP =====================
local function goFarmAndHop()
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpecialMesh")
        and obj.MeshId == "rbxassetid://129768917989779"
        and obj.Parent:IsA("BasePart") then

            -- วาปไปจุดฟาร์ม
            hrp.CFrame = obj.Parent.CFrame + Vector3.new(0,3,0)

            -- รอที่จุดฟาร์ม 10 วิ
            local startTime = tick()
            while tick() - startTime < 10 do
                task.wait(0.2)
                if not autofarm then return end
            end

            -- Hop เซิร์ฟ
            local PlaceId = game.PlaceId
            local queue = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
            if queue then
                queue([[
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/USERNAME/REPO/main/VeryHub.lua"))()
                ]])
                game:GetService("TeleportService"):Teleport(PlaceId)
            else
                warn("Executor ของคุณไม่รองรับ Server Hop อัตโนมัติ")
            end
            break
        end
    end
end

--================= BUTTON TOGGLE =====================
Button.MouseButton1Click:Connect(function()
