-- Stats UI แยกออกเพื่อมองเห็นตลอด
local statsGui = Instance.new("ScreenGui")
statsGui.Parent = game:GetService("CoreGui")
statsGui.Name = "StatsUI"

local infoFrame = Instance.new("Frame")
infoFrame.Size = UDim2.new(0.9,0,0.2,0)
infoFrame.Position = UDim2.new(0.05,0,0.15,0)
infoFrame.BackgroundTransparency = 1
infoFrame.Parent = statsGui

local function createInfoLabel(name,pos)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.22,0,1,0)
    frame.Position = pos
    frame.BackgroundColor3 = Color3.fromRGB(50,50,50)
    frame.BackgroundTransparency = 0.4
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = infoFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,12)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1,1,1)
    label.Font = Enum.Font.ArialBold
    label.TextScaled = true
    label.Text = name..": 0"
    label.Parent = frame

    return frame,label
end

local levelFrame, levelLabel = createInfoLabel("เลเวล",UDim2.new(0,0,0,0))
local expFrame, expLabel = createInfoLabel("EXP",UDim2.new(0.26,0,0,0))
local beliFrame, beliLabel = createInfoLabel("เงินเขียว",UDim2.new(0.52,0,0,0))
local fragFrame, fragLabel = createInfoLabel("เงินม่วง",UDim2.new(0.78,0,0,0))

-- อัปเดต Stats
local function updateStats()
    levelLabel.Text = "เลเวล: "..Data.Level.Value
    expLabel.Text = "EXP: "..Data.Exp.Value
    beliLabel.Text = "เงินเขียว: "..Data.Beli.Value
    fragLabel.Text = "เงินม่วง: "..Data.Fragments.Value
end

Data.Exp.Changed:Connect(updateStats)
Data.Beli.Changed:Connect(updateStats)
Data.Fragments.Changed:Connect(updateStats)
Data.Level.Changed:Connect(updateStats)
updateStats()

-- LevelUp Effect
local function onLevelUp()
    background.BackgroundColor3 = levelUpColor
    task.delay(2,function()
        background.BackgroundColor3 = defaultColor
    end)
end
Data.Level.Changed:Connect(onLevelUp)

-- Performance Mode Black Screen
local perfGui = Instance.new("ScreenGui")
perfGui.Parent = game:GetService("CoreGui")
perfGui.Name = "PerfModeGUI"
perfGui.ResetOnSpawn = false

local blackScreen = Instance.new("Frame")
blackScreen.Size = UDim2.new(1,0,1,0)
blackScreen.Position = UDim2.new(0,0,0,0)
blackScreen.BackgroundColor3 = Color3.new(0,0,0)
blackScreen.BackgroundTransparency = 0.8
blackScreen.Visible = false
blackScreen.Parent = perfGui

-- Stats อยู่บน Black Screen
infoFrame.Parent = perfGui
infoFrame.ZIndex = 1

-- คีย์บอร์ดควบคุม F2 = ลด FPS, F3 = รีจอย
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F2 then
        blackScreen.Visible = not blackScreen.Visible
    elseif input.KeyCode == Enum.KeyCode.F3 then
        -- รีจอยเกม
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end)
