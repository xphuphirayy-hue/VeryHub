--================ AUTO EXECUTOR ===================
-- ตรวจว่าเป็น Blox Fruits
local BLOX_FRUITS_PLACE = {
    [2753915549] = true,
    [4442272183] = true,
    [7449423635] = true
}

if not BLOX_FRUITS_PLACE[game.PlaceId] then
    warn("Very Hub : ไม่ใช่แมพ Blox Fruits")
    return
