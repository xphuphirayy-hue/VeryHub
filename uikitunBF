-- % โหลด
local loadTime = math.random(5,8)
local start = tick()

while tick() - start < loadTime do
    local p = math.floor(((tick()-start)/loadTime)*100)
    Percent.Text = p .. "%"
    Stroke.Transparency = 0.2 + math.sin(tick()*6)*0.3
    RunService.RenderStepped:Wait()
end

Percent.Text = "100%"
