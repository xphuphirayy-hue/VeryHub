--================= FUNCTIONS =====================
local placeId = game.PlaceId

local function isInMap(list)
    for _,id in ipairs(list) do
        if placeId == id then
            return true
        end
    end
end

local function executeScript(key)
    local url = SCRIPTS[key]
    if url then
        warn("🚀 Execute :", key)
        loadstring(game:HttpGet(url))()
    else
        warn("⚠ ไม่มีสคริปสำหรับ:", key)
    end
end

--================= MAIN CHECK =====================
local function checkMap()
    warn("📍 PlaceId:", placeId)

    for name,ids in pairs(MAPS) do
        if isInMap(ids) then

            if name == "99DAY_LOBBY" then
                warn("⏳ 99 Day Lobby — รอเข้าเกมหลัก")
                return
            end

            if name == "99DAY_GAME" then
                executeScript("99DAY")
                return
            end

            executeScript(name)
            return
        end
    end

    warn("❓ แมพนี้ยังไม่รองรับ Very Hub")
end
