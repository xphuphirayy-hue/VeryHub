--================= LOADING LOGIC =====================
local loadTime = math.random(4,5)
local start = tick()

while tick() - start < loadTime do
    local alpha = math.clamp((tick()-start)/loadTime,0,1)
    local p = math.floor(alpha * 100)

    Percent.Text = p .. "%"
    ProgressFill.Size = UDim2.new(alpha,0,1,0)
    GreenStroke.Transparency = 0.25 + math.sin(tick()*5)*0.25

    RunService.RenderStepped:Wait()
end

