-- === DETECT FUNCTION ===
local function isInMap(mapTable)
    for _, id in ipairs(mapTable) do
        if placeId == id then
            return true
        end
    end
    return false
end

-- === AUTO LOAD ===
for mapName, ids in pairs(MAPS) do
    if isInMap(ids) then

        if mapName == "99DAY_LOBBY" then
            warn("⛔ 99 Day Lobby — ยังไม่รันสคริป")
            return
        end

        local scriptKey = mapName:find("99DAY") and "99DAY" or mapName
        local url = SCRIPTS[scriptKey]

        if url then
            loadstring(game:HttpGet(url))()
        else
            warn("⚠ ไม่มีสคริปสำหรับแมพนี้")
        end

        return
    end
end

