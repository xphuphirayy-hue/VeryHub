-- ====== HELPER FUNCTIONS ======
local function isInMap(ids)
    for _, id in ipairs(ids) do
        if placeId == id then return true end
    end
    return false
end

local function executeScript(mapName)
    local key = mapName:find("99DAY") and "99DAY" or mapName
    local url = SCRIPTS[key]
    if url and url ~= "" then
        loadstring(game:HttpGet(url))()
    else
        warn("⚠ ไม่มีสคริปสำหรับแมพนี้")
    end
end

-- ====== AUTO EXECUTE ======
for mapName, ids in pairs(MAPS) do
    if isInMap(ids) then
        if mapName == "99DAY_LOBBY" then
            warn("⛔ 99 Day Lobby — จะไม่รันสคริป")
        else
            warn("🚀 Auto Execute : "..mapName)
            executeScript(mapName)
        end
        break
    end
end

