-- ================== UTIL ==================
local function IsAlive(m)
    return m and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0
end

local function HasQuest()
    local gui = player.PlayerGui:FindFirstChild("Main")
    return gui and gui:FindFirstChild("Quest") and gui.Quest.Visible
end

-- ================== FLY (ใช้เฉพาะเดินทาง) ==================
local function FlyTo(cf)
    local hrp = GetChar():WaitForChild("HumanoidRootPart")
    IsFlying = true
    local dist = (hrp.Position - cf.Position).Magnitude
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(math.clamp(dist/300,0.1,2), Enum.EasingStyle.Linear),
        {CFrame = cf}
    )
    tween:Play()
    tween.Completed:Wait()
    IsFlying = false
end

-- ================== MELEE ==================
local function IsMelee(tool)
    return tool and tool:IsA("Tool")
        and tool:FindFirstChild("weapontype")
        and tool.weapontype:FindFirstChild("melee")
end

local function EquipMelee()
    if IsEquipping then return end
    local char = GetChar()
    if char:FindFirstChildOfClass("Tool") then return end
    IsEquipping = true
    for _,tool in ipairs(player.Backpack:GetChildren()) do
        if IsMelee(tool) then
            char.Humanoid:UnequipTools()
            task.wait()
            tool.Parent = char
            break
        end
    end
    IsEquipping = false
end

-- ================== ANTI WATER ==================
local function EnableAntiWater()
    local char = GetChar()
    local hum = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
    end)
    if not WaterBV then
        WaterBV = Instance.new("BodyVelocity")
        WaterBV.MaxForce = Vector3.new(0, math.huge, 0)
        WaterBV.Velocity = Vector3.new(0, 60, 0)
        WaterBV.Parent = hrp
    end
end

local function DisableAntiWater()
    if WaterBV then
        WaterBV:Destroy()
        WaterBV = nil
    end
end

RunService.Heartbeat:Connect(function()
    if LockTarget then return end -- ❗ไม่ให้แทรกระหว่างตี
    local char = GetChar()
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    if hum:GetState() == Enum.HumanoidStateType.Swimming then
        EnableAntiWater()
    else
        DisableAntiWater()
    end
end)

-- ================== STICK ON MOB (นิ่งสนิท) ==================
local function StickOnMob(mob)
    local hrp = GetChar():WaitForChild("HumanoidRootPart")
    DisableAntiWater()
    IsFlying = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame =
        mob.HumanoidRootPart.CFrame
        * CFrame.new(0, 18, 0)
        * CFrame.Angles(0, math.rad(180), 0)
end

-- ================== FAST ATTACK ==================
RunService.RenderStepped:Connect(function()
    if not _G.AutoFarm then return end
    EquipMelee()
    RE_RegisterAttack:FireServer(0)
    local hrp = GetChar():WaitForChild("HumanoidRootPart")
    for _,mob in ipairs(Enemies:GetChildren()) do
        if IsAlive(mob) and mob:FindFirstChild("HumanoidRootPart") then
            if (mob.HumanoidRootPart.Position - hrp.Position).Magnitude <= 60 then
                RE_RegisterHit:FireServer(
                    mob.HumanoidRootPart,
                    {{mob, mob.HumanoidRootPart}}
                )
            end
        end
    end
end)

