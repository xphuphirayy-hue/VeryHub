-- ================== AUTO FARM MAIN ==================
task.spawn(function()
    while _G.AutoFarm do
        pcall(function()
            CheckQuest()
            EquipMelee()

            if not HasQuest() and not WaitingAtSpawn then
                FlyTo(TP)
                CommF:InvokeServer("StartQuest", NameQuest, num)
            end

            local found = false
            for _,mob in ipairs(Enemies:GetChildren()) do
                if mob.Name == Namemon and IsAlive(mob) then
                    found = true
                    WaitingAtSpawn = false
                    LockTarget = mob
                    repeat
                        StickOnMob(mob)
                        task.wait()
                    until not IsAlive(mob)
                    LockTarget = nil
                    IsFlying = false
                    break
                end
            end

            if not found and MonsterCF[Namemon] then
                LockTarget = nil
                WaitingAtSpawn = true
                FlyTo(MonsterCF[Namemon])
            end
        end)
        task.wait(0.1)
    end
end)

-- ================== NO CLIP ==================
RunService.Stepped:Connect(function()
    if not _G.NoClip then return end
    local char = player.Character
    if not char then return end
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end
end)

