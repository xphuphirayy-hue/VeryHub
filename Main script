-- ===== Obfuscation Utils =====
local function CH(t)
    local s=""
    for i=1,#t do s=s..string.char(t[i]) end
    return s
end

local function CAT(...)
    local r=""
    for _,v in ipairs({...}) do r=r..v end
    return r
end

